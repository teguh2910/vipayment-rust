# Gateway
BIND_ADDR=127.0.0.1:8080
# Comma-separated list of browser origins allowed to call the API.
# Use "*" to let any website call it (no credentials are allowed).
WEB_ORIGIN=http://localhost:3000,https://shop.example.com
ADMIN_TOKEN=change-me
CATALOG_SERVICE_URL=http://127.0.0.1:8081
ORDER_SERVICE_URL=http://127.0.0.1:8082
