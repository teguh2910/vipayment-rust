# Catalog service
BIND_ADDR=127.0.0.1:8081
DATABASE_URL=sqlite://data/catalog.db
LOGO_DIR=data/logos
GAMES_CONFIG_PATH=config/games.json
LOGOS_CONFIG_PATH=config/logos.json
INTERNAL_TOKEN=change-me-internal-token-min-16-chars

# Provider (VIP Reseller)
PROVIDER_VIPRESELLER_ENABLED=true
PROVIDER_VIPRESELLER_API_ID=your_api_id
PROVIDER_VIPRESELLER_API_KEY=your_api_key
# Optional: verified against md5(API_ID + API_KEY); the SDK recomputes it anyway.
PROVIDER_VIPRESELLER_SIGN=
PROVIDER_VIPRESELLER_BASE_URL=https://vip-reseller.co.id/api
PROVIDER_TIMEOUT_SECONDS=20
# Keep true when the provider only allowlists your IPv4 address.
PROVIDER_FORCE_IPV4=true

# Catalog pricing
MARKUP_PERCENT=5
# Storefront allowlist (comma-separated category slugs). Unset = all categories.
# Game/app groups have no category, so setting this hides them too.
# CATALOG_CATEGORIES=pulsa-reguler,pulsa-transfer,pulsa-internasional,paket-internet,paket-telepon,paket-lainnya,token-pln
# Optional per-category margins (JSON, single-quoted in .env). Missing keys fall
# back to MARKUP_PERCENT. Keys: game, app, pulsa-reguler, pulsa-transfer,
# pulsa-internasional, paket-internet, paket-telepon, paket-lainnya,
# saldo-emoney, token-pln, streaming-tv, voucher-game
# MARKUP_BY_CATEGORY='{"game": 7, "app": 10, "pulsa-reguler": 4}'
# Fixed rupiah margin per category (takes precedence over the percentage rule).
# MARKUP_FIXED_BY_CATEGORY='{"pulsa-reguler": 500, "pulsa-transfer": 500, "token-pln": 1000}'
