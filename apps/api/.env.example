# Provider (VIP Reseller)
PROVIDER_VIPRESELLER_ENABLED=true
PROVIDER_VIPRESELLER_API_ID=your_api_id
PROVIDER_VIPRESELLER_API_KEY=your_api_key
# Optional: verified against md5(API_ID + API_KEY); the SDK recomputes it anyway.
PROVIDER_VIPRESELLER_SIGN=
PROVIDER_VIPRESELLER_BASE_URL=https://vip-reseller.co.id/api
PROVIDER_TIMEOUT_SECONDS=20
# Keep true when the provider only allowlists your IPv4 address.
PROVIDER_FORCE_IPV4=true

# Server
BIND_ADDR=127.0.0.1:8080
WEB_ORIGIN=http://localhost:3000
ADMIN_TOKEN=change-me
DATABASE_URL=sqlite://data/app.db
UPLOAD_DIR=data/uploads
GAMES_CONFIG_PATH=config/games.json

# Catalog
MARKUP_PERCENT=5

# Payments: manual | simulation
PAYMENT_PROVIDER=manual
PAYMENT_EXPIRY_MINUTES=1440
SIMULATION_AUTO_PAY_SECONDS=5
MAX_ORDER_AMOUNT=10000000

# Manual payment instructions
MANUAL_QRIS_IMAGE_URL=
MANUAL_BANK_ACCOUNTS='[{"bank":"BCA","account_no":"1234567890","account_name":"Nama Pemilik"}]'
