# Order service
BIND_ADDR=127.0.0.1:8082
DATABASE_URL=sqlite://data/orders.db
UPLOAD_DIR=data/uploads
CATALOG_SERVICE_URL=http://127.0.0.1:8081
INTERNAL_TOKEN=change-me-internal-token-min-16-chars
# Also validated here (defense in depth); must match the gateway's ADMIN_TOKEN.
ADMIN_TOKEN=change-me

# Payments: manual | simulation
PAYMENT_PROVIDER=manual
PAYMENT_EXPIRY_MINUTES=1440
SIMULATION_AUTO_PAY_SECONDS=5
MAX_ORDER_AMOUNT=10000000

# Manual payment instructions
MANUAL_QRIS_IMAGE_URL=
MANUAL_BANK_ACCOUNTS='[{"bank":"BCA","account_no":"1234567890","account_name":"Nama Pemilik"}]'
