/target
# Cargo.lock is committed: the service images build from it for reproducible
# dependency versions. (The SDK crate is published from git, not crates.io.)
**/*.rs.bk
*.pdb

# Environment variables
.env
.env.*
!.env.example

# API runtime data
/apps/*/data/
/apps/*/.env

# Tooling state
.commandcode/

# Web app
/web/node_modules/
/web/.next/
/web/.env.local
/web/out/
*.tsbuildinfo

# IDEs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
